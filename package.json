{
  "name": "dBrainX",
  "private": true,
  "scripts": {
    "icons:generate": "node scripts/generate-icons.mjs",
    "build": "pnpm --filter server build && pnpm --filter web build",
    "dev": "node scripts/dev-run.mjs",
    "dev:remote": "node scripts/dev-run.mjs --remote",
    "policy": "node scripts/policy/apply-ruleset.mjs",
    "pb:admin": "node scripts/dev-pocketbase-admin.mjs",
    "lint": "pnpm -r --no-bail --workspace-concurrency=2 --if-present run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "pnpm -r --no-bail --workspace-concurrency=2 --if-present run typecheck",
    "dev:desktop": "pnpm --filter desktop desktop:dev",
    "build:desktop": "pnpm --filter desktop desktop:build",
    "release:check": "node scripts/release/check.mjs",
    "release:version": "node scripts/release/version.mjs",
    "test:release": "node --experimental-strip-types --test --test-isolation=none scripts/release/run-release-tests.mjs",
    "smoke:server": "node scripts/release/server-smoke.mjs",
    "sandbox:real": "node scripts/release/sandbox-real.mjs",
    "lint:gate": "node scripts/release/lint-gate.mjs",
    "test:ui": "node scripts/run-ui-tests.mjs",
    "test:e2e": "playwright test --config scripts/e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "concurrently": "^9.0.0",
    "prettier": "^3.7.4",
    "turbo": "^2.9.6",
    "typescript": "5.9.2",
    "@playwright/test": "^1.64.1"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "packageExtensions": {
      "node-pty@1.1.0": {
        "dependencies": {
          "node-gyp": "^13.1.0"
        }
      }
    }
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "license": "AGPL-3.0-only"
}
