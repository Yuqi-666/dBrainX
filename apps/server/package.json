{
  "name": "server",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:pb": "node ../../scripts/dev-pocketbase.mjs",
    "build": "node scripts/build.mjs",
    "start": "node dist/index.mjs",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@plugin/builtin": "workspace:*",
    "@workspace/adapter-front": "workspace:*",
    "@workspace/application": "workspace:*",
    "@workspace/domain": "workspace:*",
    "@workspace/infrastructure": "workspace:*",
    "@workspace/interfaces": "workspace:*",
    "@workspace/plugin-host": "workspace:*",
    "@workspace/utils": "workspace:*",
    "pocketbase": "^0.26.9"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "concurrently": "^9.0.0",
    "eslint": "^9.39.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "esbuild": "0.27.7"
  }
}
