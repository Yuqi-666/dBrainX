{
  "extends": [
    "@workspace/typescript-config/nextjs.json",
    "../../tsconfig.workspace.json"
  ],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    // Declared here rather than inherited: Turbopack needs the app's own
    // tsconfig to carry the repo-root `baseUrl` the `paths` values are written
    // against, or `next dev` cannot resolve any alias. See `apps/web/tsconfig.json`.
    "baseUrl": "../..",
    "paths": {
      "@workspace/adapter-back": [
        "backend/adapter-back/src"
      ],
      "@workspace/adapter-back/*": [
        "backend/adapter-back/src/*"
      ],
      "@workspace/adapter-front": [
        "backend/adapter-front/src"
      ],
      "@workspace/adapter-front/*": [
        "backend/adapter-front/src/*"
      ],
      "@workspace/application": [
        "backend/application/src"
      ],
      "@workspace/application/*": [
        "backend/application/src/*"
      ],
      "@workspace/domain": [
        "backend/domain/src"
      ],
      "@workspace/domain/*": [
        "backend/domain/src/*"
      ],
      "@workspace/infrastructure": [
        "backend/infrastructure/src"
      ],
      "@workspace/infrastructure/*": [
        "backend/infrastructure/src/*"
      ],
      "@workspace/plugin-host": [
        "backend/plugin-host/src"
      ],
      "@workspace/plugin-host/*": [
        "backend/plugin-host/src/*"
      ],
      "@workspace/sandbox": [
        "backend/sandbox/src"
      ],
      "@workspace/sandbox/*": [
        "backend/sandbox/src/*"
      ],
      "@workspace/api-client": [
        "packages/api-client/src/index.ts"
      ],
      "@workspace/api-client/*": [
        "packages/api-client/src/*"
      ],
      "@workspace/dataview": [
        "packages/dataview/src/index.ts"
      ],
      "@workspace/dataview/*": [
        "packages/dataview/src/*"
      ],
      "@workspace/editor": [
        "packages/editor/src"
      ],
      "@workspace/editor/*": [
        "packages/editor/*"
      ],
      "@workspace/graph": [
        "packages/graph/src/index.ts"
      ],
      "@workspace/graph/*": [
        "packages/graph/src/*"
      ],
      "@workspace/hooks": [
        "packages/hooks/src"
      ],
      "@workspace/hooks/*": [
        "packages/hooks/src/*"
      ],
      "@workspace/interfaces": [
        "packages/interfaces/src"
      ],
      "@workspace/interfaces/*": [
        "packages/interfaces/src/*"
      ],
      "@workspace/plugin-sdk": [
        "packages/plugin-sdk/src/index.ts"
      ],
      "@workspace/plugin-sdk/*": [
        "packages/plugin-sdk/src/*"
      ],
      "@workspace/services": [
        "packages/services/src/index.ts"
      ],
      "@workspace/services/*": [
        "packages/services/src/*"
      ],
      "@workspace/store": [
        "packages/store/src/index.ts"
      ],
      "@workspace/store/*": [
        "packages/store/src/*"
      ],
      "@workspace/ui": [
        "packages/ui/src"
      ],
      "@workspace/ui/*": [
        "packages/ui/src/*"
      ],
      "@workspace/utils": [
        "packages/utils/src/index.ts"
      ],
      "@workspace/utils/*": [
        "packages/utils/src/*"
      ],
      "@plugin/*": [
        "plugins/*"
      ],
      "@plugin/*/ui": [
        "plugins/*/ui"
      ],
      "@plugin/*/server": [
        "plugins/*/server"
      ],
      "@/*": [
        "apps/web/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "../../packages/ui/src/img/icon/svg.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
