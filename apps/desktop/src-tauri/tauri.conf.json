{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "dBrainX",
  "version": "0.3.0",
  "identifier": "cn.dbrainx.desktop",
  "build": {
    "beforeDevCommand": "pnpm runtime:prepare && pnpm dev",
    "beforeBuildCommand": "pnpm runtime:prepare && pnpm build",
    "devUrl": "http://localhost:3002",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "dBrainX",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob: http: https:; font-src 'self' data:; media-src 'self' blob: data: http: https:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; worker-src 'self' blob:; frame-src 'self' blob: http: https:; object-src 'none'; base-uri 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "runtime/": "runtime/"
    },
    "linux": {
      "rpm": {
        "compression": {
          "type": "zstd",
          "level": 3
        }
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "shortDescription": "dBrainX local knowledge workspace",
    "copyright": "Copyright (c) 2026 dBrainX contributors"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI0RkY3OEI0OEVGNjQxRjIKUldUeVFmYU90SGovdEdQUkdCNXNPemZSM0Y5aWF4ZmZmTmFONjQzeW9EUHBucFVCUytEZ0QrN2EK",
      "endpoints": [
        "https://github.com/Yuqi-666/dBrainX/releases/latest/download/latest.json"
      ]
    }
  }
}
