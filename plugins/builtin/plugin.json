{
  "id": "dbrainx.builtin",
  "name": "dBrainX builtin",
  "version": "0.1.0",
  "apiVersion": "1",
  "serverEntry": "./server/index.ts",
  "nodeTypesEntry": "./server/node-types.ts",
  "uiEntry": "./ui/index.ts",
  "dependencies": [],
  "nodeTypes": [
    "text",
    "rich-text",
    "image",
    "pdf",
    "video",
    "audio",
    "webpage",
    "website",
    "collection",
    "database"
  ],
  "permissions": [
    {
      "capability": "node.create",
      "scope": ["nodeType=*"],
      "reason": "node.add creates a node of any type this plugin contributes"
    },
    {
      "capability": "node.write",
      "scope": ["nodeType=*"],
      "reason": "the builtin metadata operations write content, state, tags, icon and cover"
    },
    {
      "capability": "node.delete",
      "scope": ["nodeType=*"],
      "reason": "node.delete removes a node the user selected"
    },
    {
      "capability": "edge.create",
      "scope": ["nodeType=*"],
      "reason": "edge.create connects two nodes the user selected"
    },
    {
      "capability": "edge.delete",
      "scope": ["nodeType=*"],
      "reason": "edge.delete removes a connection the user selected"
    },
    {
      "capability": "storage.read",
      "scope": ["path=*"],
      "reason": "the attachFile operations read the stored upload they attach"
    }
  ]
}
