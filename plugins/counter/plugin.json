{
  "id": "dbrainx.counter",
  "name": "dBrainX counter fixture",
  "version": "0.1.0",
  "apiVersion": "1",
  "serverEntry": "./server/index.ts",
  "nodeTypesEntry": "./server/index.ts",
  "uiEntry": "./ui/index.ts",
  "dependencies": [],
  "nodeTypes": [
    "counter",
    "acme.a",
    "acme.b"
  ],
  "events": [
    "acme.*"
  ],
  "permissions": [
    {
      "capability": "sandbox.exec",
      "scope": [
        "executable=python3"
      ],
      "reason": "acme.b.run executes the node's script with python3"
    },
    {
      "capability": "sandbox.fs.read",
      "scope": [
        "path=nodes/*"
      ],
      "reason": "acme.b.run reads the node sandbox directory it writes"
    },
    {
      "capability": "sandbox.fs.write",
      "scope": [
        "path=nodes/*"
      ],
      "reason": "acme.b.run writes nodes/<B>/script.py before executing it"
    },
    {
      "capability": "node.write",
      "scope": [
        "nodeType=acme.b"
      ],
      "reason": "acme.b.run writes content.lastRun back to the node"
    },
    {
      "capability": "event.emit",
      "scope": [
        "eventType=*"
      ],
      "reason": "acme.a.fire emits acme.a.fired and acme.b.run emits acme.b.executed"
    },
    {
      "capability": "event.subscribe",
      "scope": [
        "eventType=acme.*"
      ],
      "reason": "the acme.b.on-a-fired trigger listens to acme.a.fired"
    }
  ],
  "checksum": "sha256:7f028db06a3031e35235e1152c8405cd1ee8470c312ceebad53b82e67c1268fa",
  "publicKeyId": "dbrainx.test-key",
  "signature": "ed25519:Y756tMuZoL0rk1bJIc2gDhczqKMBI5rQJJj5QbSgjkVwdfXBoh7DZPO7ZQw7JRYCXfzwyGKeiZ2/lqlEXxCVDA=="
}
