{
  "id": "dbrainx.counter",
  "name": "dBrainX counter fixture",
  "version": "0.1.0",
  "apiVersion": "1",
  "serverEntry": "./server/index.ts",
  "nodeTypesEntry": "./server/index.ts",
  "uiEntry": "./ui/index.ts",
  "dependencies": [],
  "nodeTypes": [
    "counter",
    "acme.a",
    "acme.b"
  ],
  "events": [
    "acme.*",
    "counter.*"
  ],
  "permissions": [
    {
      "capability": "sandbox.exec",
      "scope": [
        "executable=python3"
      ],
      "reason": "acme.b.run executes the node's script with python3"
    },
    {
      "capability": "sandbox.fs.read",
      "scope": [
        "path=nodes/*"
      ],
      "reason": "acme.b.run reads the node sandbox directory it writes"
    },
    {
      "capability": "sandbox.fs.write",
      "scope": [
        "path=nodes/*"
      ],
      "reason": "acme.b.run writes nodes/<B>/script.py before executing it"
    },
    {
      "capability": "node.write",
      "scope": [
        "nodeType=*"
      ],
      "reason": "acme.b.run writes content.lastRun and the monitor fixture writes its cursor, sample and notifications"
    },
    {
      "capability": "event.emit",
      "scope": [
        "eventType=*"
      ],
      "reason": "acme.a.fire emits acme.a.fired and acme.b.run emits acme.b.executed"
    },
    {
      "capability": "event.subscribe",
      "scope": [
        "eventType=acme.*",
        "eventType=counter.*"
      ],
      "reason": "acme.b.on-a-fired listens to acme.a.fired and counter.notifier.on-threshold listens to the monitor event"
    }
  ],
  "checksum": "sha256:ac43d9703e13e920c43e965c7d56c801121fa245da25c9894f83b7db61793bfd",
  "publicKeyId": "dbrainx.test-key",
  "signature": "ed25519:nzrGf3+7SiOu9knhzxs66xoLHWG2LRkermA59M4RTHWdujLhNoAgIKIApl/C8rzf/tpgev+FuQY10a1YxxfqBQ=="
}
